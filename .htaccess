Options -Indexes

RewriteEngine On

RewriteRule ^$ index.php?page=home [QSA,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([a-zA-Z0-9-]+)/?$ index.php?page=$1 [QSA,L]

<FilesMatch "^(?:\.env|composer\.(?:json|lock)|README\.md)$">
    Require all denied
</FilesMatch>
